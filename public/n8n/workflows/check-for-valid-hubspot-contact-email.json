          }
        ]
      ]
    },
    "If email is suspicious": {
      "main": [
        [
          {
            "node": "Send to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get contact email address": {
      "main": [
        [
          {
            "node": "validate the email",
            "type": "main",
