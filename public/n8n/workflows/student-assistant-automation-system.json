    },
    {
      "parameters": {
        "jsCode": "let message = `⏰ Deadlines Reminder:\\n\\n`;\n\nitems.forEach(item => {\n  const task = item.json.Type;\n  const course = item.json.Course;\n  const dueDate = item.json[\"Date\"];\n  const description = item.json.description; // make sure field exists\n\n  // Add description only if it exists\n  message += `• ${task} ${course}${description ? ` (${description})` : \"\"} – Due: ${dueDate}\\n`;\n});\n\nreturn [{ json: { message } }];\n"
      },
