        "mode": "runOnceForEachItem",
        "jsCode": "const days = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"];\nconst now = new Date();\n$input.item.json.day = days[now.getDay()];\nreturn $input.item;"
      },
