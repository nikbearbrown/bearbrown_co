    },
    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  const from = item.json.From\n  const name = from.split('<')[0].trim();\n  item.json.From = name;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -704,
        -448
      ],
      "id": "[HIDDEN_NODE_ID]",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "const today = new Date();\nconst reminderDays = 2;\n\nreturn items.filter(item => {\n  const dueDate = new Date(item.json[\"Date\"]);\n  const diffTime = dueDate - today;\n  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n  return diffDays <= reminderDays && diffDays >= 0;\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        -32
      ],
