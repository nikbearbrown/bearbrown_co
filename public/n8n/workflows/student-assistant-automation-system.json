      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Combine all rows into a single message\nlet message = `📅 Your schedule for ${items[0].json.day}:\\n\\n`;\n\nitems.forEach(item => {\n  const time = item.json[\"Hour\"];\n  const type = item.json[\"Type\"]\n  const name = item.json[\"module\"];\n  const room = item.json[\"Classroom\"];\n  message += `${time} – ${type} ${name} – Room: ${room}\\n`;\n});\n\n// Return a single item with the full message\nreturn [{ json: { message } }];\n"
      },
      "type": "n8n-nodes-base.code",
