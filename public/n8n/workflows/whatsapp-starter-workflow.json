      "position": [
        240,
        260
      ],
      "parameters": {
        "color": 3,
        "width": 405,
        "height": 177,
        "content": "## Important!\n### Configure the webhook nodes this way:\n* Make sure that both *Verify* and *Respond* have the same URL\n* *Verify* should have GET HTTP Method\n* *Respond* should have POST HTTP Method"
      },
      "typeVersion": 1
    },
